# Active Provider: "groq", "ollama", "gemini", "openai", "anthropic", or "custom"
LLM_PROVIDER=groq

# -----------------------------------------------------------------
# 1. Groq (Ultra-Fast Inference - Free tier available)
# -----------------------------------------------------------------
# Popular models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# Multi-key rotation enabled (comma-separated list for automatic 429 rate limit & capacity failover)
GROQ_API_KEYS=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# -----------------------------------------------------------------
# 2. Ollama (Local Air-Gapped / On-Premise LLM)
# -----------------------------------------------------------------
# When Ollama is installed, start it with `ollama serve` and pull a model:
# `ollama pull llama3` or `ollama pull mistral` or `ollama pull deepseek-r1`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# -----------------------------------------------------------------
# 3. Google Gemini
# -----------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------
# 4. OpenAI
# -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------
# 5. Anthropic Claude
# -----------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# -----------------------------------------------------------------
# 6. Custom / OpenAI-Compatible (vLLM, LM Studio, Groq, DeepSeek)
# -----------------------------------------------------------------
CUSTOM_LLM_BASE_URL=http://localhost:8000/v1
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=default
