alert udp $HOME_NET any -> $EXTERNAL_NET 53 ( msg:"PROTOCOL-DNS DNS_TUNNELING dns2tcp TXT query data exfiltration"; flow:to_server,no_stream; dns_query; regex:"/[A-Za-z0-9]{20,}\\.dns2tcp-txt\\.com/i",fast_pattern,nocase; pkt_data; content:"\x00\x10"; service:dns; classtype:trojan-activity; metadata:policy max-detect-ips drop, ruleset community, malware_family DNS_Tunneling; sid:9002029; rev:1; )
