alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS ( msg:"EXPLOIT-WEB SQL Injection UNION SELECT attempt"; flow:to_server,established,only_stream; http_uri; content:"' UNION SELECT",nocase,fast_pattern; service:http; classtype:web-application-attack; metadata:policy max-detect-ips drop, ruleset community, malware_family SQL_Injection; sid:9001002; rev:1; )
