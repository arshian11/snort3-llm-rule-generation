alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS ( msg:"SERVER-WEBAPP-LOG4J JNDI LDAP payload detected in HTTP User-Agent header"; flow:to_server,established,only_stream; http_header; content:"${jndi:ldap://",nocase,fast_pattern; classtype:web-application-attack; reference:cve,2021-44228; reference:url,attack.mitre.org/techniques/T1059/; metadata:policy max-detect-ips drop, ruleset community, malware_family Log4j_RCE___Cobalt_Strike_C2; sid:1000203; rev:1; )
