alert tcp $HOME_NET any -> $EXTERNAL_NET any ( msg:"PROTOCOL-DNS DNS_TUNNELING Suspicious DNS tunneling activity detected"; flow:to_server,established; raw_data; content:"malicious_artifact",nocase,fast_pattern; bufferlen:>50; service:dns; classtype:malware-cnc; metadata:policy max-detect-ips drop, ruleset community, malware_family DNS_Tunneling; sid:9002030; rev:1; )
