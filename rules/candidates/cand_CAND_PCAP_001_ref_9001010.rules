alert tcp $EXTERNAL_NET any -> $HOME_NET any ( msg:"MALWARE-CNC Log4j RCE attempt via malicious User-Agent and Cobalt Strike beaconing to /api/v2/beacon"; flow:to_server,established; content:"${jndi:ldap://",nocase,fast_pattern; content:"/api/v2/beacon",nocase; classtype:malware-cnc; reference:cve,2021-44228; metadata:policy max-detect-ips drop, ruleset community, malware_family Log4j_RCE___Cobalt_Strike_C2; sid:9001010; rev:1; )
