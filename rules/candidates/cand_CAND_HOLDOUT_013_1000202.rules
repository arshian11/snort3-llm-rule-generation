alert tcp $HOME_NET any -> $EXTERNAL_NET $HTTP_PORTS ( msg:"MALWARE-CNC Hancitor Loader outbound HTTP POST to /ls5/forum.php or /mlu/forum.php"; flow:to_server,established,only_stream,no_frag; http_uri; content:"/ls5/forum.php",nocase,fast_pattern; content:"/mlu/forum.php",nocase; service:http; classtype:malware-cnc; reference:url,attack.mitre.org/techniques/T1071/001/; metadata:policy max-detect-ips drop, ruleset community, malware_family Hancitor_Loader__IcedID___ZLoader_; sid:1000202; rev:1; )
