alert tcp $HOME_NET any -> $EXTERNAL_NET 80 ( msg:"MALWARE-CNC Cobalt Strike HTTP beacon request for long random /uploaded/ URI ending with .pct or .pmg"; flow:to_server,established,only_stream; http_uri; content:"/uploaded/",nocase,fast_pattern; pcre:"/\\/uploaded\\/[A-Za-z0-9_-]+\\.(pct|pmg)/i"; http_header; content:"User-Agent: Mozilla/4.0 (compatible; MSIE 8.0; Windows NT 10.0)",nocase; service:http; classtype:malware-cnc; metadata:policy max-detect-ips drop, ruleset community, malware_family Cobalt_Strike; sid:9002021; rev:1; )
