alert http $HOME_NET any -> $EXTERNAL_NET any ( msg:"MALWARE-CNC CTU-13 Synapse User-Agent outbound executable request"; flow:to_server,established,only_stream,no_frag; http_header; content:"Synapse",nocase,fast_pattern; http_uri; content:".exe",nocase; service:http; classtype:malware-cnc; metadata:policy max-detect-ips drop, ruleset community, malware_family CTU-13_Botnet; sid:9002008; rev:1; )
