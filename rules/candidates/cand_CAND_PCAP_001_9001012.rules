alert tcp $EXTERNAL_NET any -> $HOME_NET 443 ( msg:"SERVER-WEBAPP Log4j JNDI injection attempt via User-Agent header"; flow:to_server,established,only_stream,no_frag; http_header; content:"User-Agent: ${jndi:ldap:",nocase,fast_pattern; http_uri; content:"/api/login",nocase; classtype:web-application-attack; reference:cve,2021-44228; metadata:policy max-detect-ips drop, ruleset community, malware_family Log4j_RCE___Cobalt_Strike_C2; sid:9001012; rev:1; )
