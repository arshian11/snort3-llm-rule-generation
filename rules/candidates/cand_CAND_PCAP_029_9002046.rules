alert udp $HOME_NET any -> $EXTERNAL_NET 53 ( msg:"PROTOCOL-DNS DNS_TUNNELING DNS query to .dns2tcp-txt.com indicating possible data exfiltration"; flow:to_server,no_stream; content:"evil_payload",nocase,offset 0,depth 100; pcre:"/badpattern/i"; content:"|0B|dns2tcp-txt|03|com|00|",nocase,fast_pattern; service:dns; classtype:malware-cnc; metadata:policy max-detect-ips drop, ruleset community, malware_family DNS_Tunneling; sid:9002046; rev:1; )
