alert tcp $HOME_NET any -> $EXTERNAL_NET $HTTP_PORTS ( msg:"MALWARE-CNC Cobalt Strike HTTP beacon task retrieval"; flow:to_server,established,only_stream; http_uri; pcre:"/\\/api\\/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\/tasks/i"; http_header; content:"User-Agent: Mozilla/5.0 (Windows NT 10.0",nocase,fast_pattern; service:http; classtype:malware-cnc; metadata:policy max-detect-ips drop, ruleset community, malware_family Cobalt_Strike; sid:9002022; rev:1; )
