alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS ( msg:"SERVER-WEBAPP-LOG4J HTTP request containing JNDI LDAP payload in User-Agent header"; flow:to_server,established,only_stream; http_header; content:"${jndi:ldap://",nocase,fast_pattern; http_uri; content:"/api/login",nocase; service:http; classtype:web-application-attack; reference:cve,2021-44228; reference:url,attack.mitre.org/techniques/T1059/; metadata:policy max-detect-ips drop, ruleset community, malware_family Log4j_RCE___Cobalt_Strike_C2; sid:1000205; rev:1; )
