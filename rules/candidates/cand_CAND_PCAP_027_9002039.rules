alert udp $HOME_NET any -> $EXTERNAL_NET any ( msg:"PROTOCOL-DNS DNS-TUNNEL High-entropy subdomain exfiltration"; flow:to_server; http_uri; content:"/malicious_path",nocase,fast_pattern; http_client_body; content:"password=",nocase; pcre:"/[a-f0-9]{32}/"; byte_test:4,>,0xdeadbeef,0,little; service:dns; classtype:malware-cnc; metadata:policy max-detect-ips drop, ruleset community, malware_family DNS_Tunneling; sid:9002039; rev:1; )
