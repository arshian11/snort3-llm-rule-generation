alert tcp $EXTERNAL_NET any -> $HOME_NET 22 ( msg:"EXPLOIT-SSH Recon inbound SYN scan to SSH port"; flow:to_server,not_established,no_stream; content:"tcp_flags:SYN",nocase,fast_pattern; classtype:attempted-recon; metadata:policy max-detect-ips drop, ruleset community, malware_family SSH_Recon; sid:9002004; rev:1; )
