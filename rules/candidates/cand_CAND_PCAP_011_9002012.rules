alert tcp $HOME_NET any -> $EXTERNAL_NET $HTTP_PORTS ( msg:"EXPLOIT-Angler Exploit Kit HTTP GET beacon with 64-character hex sid/id parameter"; flow:to_server,established,only_stream,no_frag; http_uri; regex:"/weblinks\\.php\\?sid=[A-F0-9]{64}/i",fast_pattern,nocase; regex:"/api\\.php\\?id=[A-F0-9]{64}/i",nocase; service:http; classtype:malware-cnc; metadata:policy max-detect-ips drop, ruleset community, malware_family Angler_Exploit_Kit; sid:9002012; rev:1; )
