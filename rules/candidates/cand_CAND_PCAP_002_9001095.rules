alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS ( msg:"EXPLOIT-Web SQL Injection GET request containing single-quote character"; flow:to_server,established,only_stream; http_uri; content:"/products?id=1'",nocase,fast_pattern; service:http; classtype:web-application-attack; metadata:policy max-detect-ips drop, ruleset community, malware_family SQL_Injection; sid:9001095; rev:1; )
