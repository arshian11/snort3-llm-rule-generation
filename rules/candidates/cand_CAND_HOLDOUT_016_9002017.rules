alert tcp $HOME_NET any -> $EXTERNAL_NET $HTTP_PORTS ( msg:"MALWARE-CNC Qakbot HTTP GET for malicious ZIP payload under /ssv/ path"; flow:to_server,established,only_stream; http_uri; content:"/ssv/",nocase,fast_pattern; pcre:"/\\.zip$/i"; service:http; classtype:malware-cnc; metadata:policy max-detect-ips drop, ruleset community, malware_family Qakbot_Banking_Trojan; sid:9002017; rev:1; )
