alert tcp $HOME_NET any -> $EXTERNAL_NET 53 ( msg:"PROTOCOL-DNS DNS_TUNNELING Data exfiltration via DNS queries"; flow:to_server,established,only_stream,only_frag; http_uri; http_method; http_header; http_cookie; service:dns; classtype:malware-cnc; metadata:policy max-detect-ips drop, ruleset community, malware_family DNS_Tunneling; sid:9002028; rev:1; )
