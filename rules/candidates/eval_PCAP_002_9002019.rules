alert tcp $EXTERNAL_NET any -> $HOME_NET any ( msg:"EXPLOIT SQLI HTTP GET request to /products with unescaped single-quote in query string"; flow:to_server,established; content:"/products",nocase; content:"id=1'",nocase,fast_pattern; service:http; classtype:web-application-attack; metadata:policy max-detect-ips drop, ruleset community, malware_family SQL_Injection; sid:9002033; rev:1; )
