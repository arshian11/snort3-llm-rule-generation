alert udp $HOME_NET any -> $EXTERNAL_NET 53 ( msg:"PROTOCOL-DNS DNS_TUNNELING High-entropy DNS query to .ozymandns-txt.com suffix"; flow:to_server; content:"|0D|ozymandns-txt|03|com|00|",nocase,fast_pattern; regex:"/[0-9a-zA-Z]{5,}\\.ozymandns-txt\\.com/",nocase; service:dns; classtype:trojan-activity; metadata:policy max-detect-ips drop, ruleset community, malware_family DNS_Tunneling; sid:9002043; rev:1; )
