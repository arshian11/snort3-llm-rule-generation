alert tcp $HOME_NET any -> $EXTERNAL_NET any ( msg:"PROTOCOL-DNS DNS2TCP TXT exfiltration attempt"; flow:to_server; content:"|0B|dns2tcp-txt|03|com|00|",nocase,fast_pattern; pcre:"/\\x0[0-9][A-Za-z0-9]+\\x0Bdns2tcp-txt\\x03com\\x00/i"; service:dns; classtype:trojan-activity; metadata:policy max-detect-ips drop, ruleset community, malware_family DNS_Tunneling; sid:9002042; rev:1; )
