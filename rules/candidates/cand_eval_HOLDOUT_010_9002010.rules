alert tcp $HOME_NET any -> $EXTERNAL_NET $HTTP_PORTS ( msg:"MALWARE-CNC-CTU13 Zeus/CTU-13 botnet HTTP GET beacon with MSIE 7.0 User-Agent, no Referer, no Cookie"; flow:to_server,established,only_stream; http_header; content:"User-Agent: Mozilla/4.0 (compatible; MSIE 7.0;",nocase,fast_pattern; service:http; classtype:malware-cnc; metadata:policy max-detect-ips drop, ruleset community, malware_family CTU-13_Botnet; sid:9002011; rev:1; )
